+def _openai_embed_batch_size() -> int:
+    """ResumeTrace: batch ceiling for OpenAI-compatible embedding endpoints.
+
+    Upstream hard-codes 16 (OpenAI's own limit). DashScope compatible-mode
+    rejects batches >10, which made multi-chunk documents fail parsing with
+    HTTP 400. Deployments opt in via RAGFLOW_EMBED_BATCH_SIZE; default keeps
+    upstream behaviour.
+    """
+    try:
+        return max(1, int(os.environ.get("RAGFLOW_EMBED_BATCH_SIZE", "16")))
+    except ValueError:
+        return 16
 
 
