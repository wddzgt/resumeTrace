# RAGFlow 连接配置(复制为 ragflow.yaml 使用,真实 api_key 走环境变量,不入库)
base_url: http://localhost:9380
api_key_env: RAGFLOW_API_KEY      # 测试启动时向用户询问,export 后使用
dataset_name: resumetrace-lib
parser_id: resume
# 建库时锁定的 embedding 模型名,仅记录用,实际配置在 RAGFlow 租户里
embedding_model: ""
chat_model: ""
reranker_model: ""                 # 可选
